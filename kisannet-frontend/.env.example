# KisanNet Frontend Environment Configuration

# Backend API Base URL (Local vs Production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenWeather API Key for Hyperlocal Weather Updates
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# LiveKit WebRTC Voice Configuration
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# Firebase Configuration (Authentication & Cloud Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
