# KisanNet Backend Environment Configuration

# Server & Environment
ENVIRONMENT=development
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Database Connection (PostgreSQL 15+ with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kisannet

# Redis Cache & Session Tracking
REDIS_URL=redis://localhost:6379/0

# Google AI Credentials & Cloud Services
GOOGLE_API_KEY=AIzaSyYourGoogleAIStudioApiKeyHere
GEMINI_API_KEY=AIzaSyYourGoogleAIStudioApiKeyHere
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google_cloud_credentials.json
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# LiveKit WebRTC Voice Agent
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Twilio IVR Phone Call Service
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# External APIs
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
